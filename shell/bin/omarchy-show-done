#!/bin/bash
# Blackshield override. Stock omarchy-show-done paints the bullet in \033[32m.
# Same PATH win as omarchy-show-logo. Bullet uses the live theme accent.

colors="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/current/theme/colors.toml"
accent="#C1121F"

if [[ -f "$colors" ]]; then
  parsed=$(awk -F'"' '/^accent[[:space:]]*=/ { print $2; exit }' "$colors")
  [[ "$parsed" =~ ^#[0-9A-Fa-f]{6}$ ]] && accent="$parsed"
fi

hex=${accent#\#}
r=$((16#${hex:0:2}))
g=$((16#${hex:2:2}))
b=$((16#${hex:4:2}))

: 2>/dev/null <>/dev/tty || exit 0

while read -rsn 1 -t 0.1 _ </dev/tty; do :; done

printf '\n\033[38;2;%d;%d;%dm● \033[0mDone! Press any key to close...' "$r" "$g" "$b" >/dev/tty
read -rsn 1 </dev/tty
echo >/dev/tty
